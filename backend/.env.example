# Earthworm Advisory Backend Configuration
# Safe defaults: No external credentials are required for local demo/development.

APP_NAME="Earthworm Advisory Backend"
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api

# Optional Supabase Database & Auth Configuration
# Copy this file to `backend/.env` and replace placeholders with your project details.
# The backend stays fully operational with demo fixtures if these remain unconfigured.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key

# Optional GitHub Personal Access Token (for repository automation)
# GITHUB_TOKEN=ghp_...
